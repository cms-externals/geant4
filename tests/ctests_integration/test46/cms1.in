#================================================
#     Macro file for test46
#================================================
/control/verbose 2
/run/verbose 1
/tracking/verbose 0
#
/testCalorim/nbins 100
/testCalorim/maxE 50. GeV
/testCalorim/factEcal 1.03 
/testCalorim/factHcal 100.0
/testCalorim/preShowerLength 3 cm
#
/testhadr/histo/emax 50 GeV
/testhadr/PrintModulo 100
/run/initialize
/run/setCut 1 cm
/run/setCutForRegion EcalRegion 2 mm
/run/setCutForRegion HcalRegion 1 mm
/gun/particle pi-
/gun/energy 50. GeV
/run/beamOn 50
#



