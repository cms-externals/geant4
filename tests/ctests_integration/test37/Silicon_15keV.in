/run/verbose 1
/testem/det/setMat1 G4_Si
#
## 15 keV e- range in Si = 0.693944 [mg/cm2]
/testem/det/setThick1 2.9783 um
#
/testem/det/setNbOfLayers1 100
#
/testem/phys/addPhysics  PHYSLIST
#
#/testem/phys/addPhysics  standard
#/testem/phys/addPhysics  emstandardGS
#/testem/phys/addPhysics  emstandard_opt3
#/testem/phys/addPhysics  emstandard_opt4
#/testem/phys/addPhysics  livermore
#/testem/phys/addPhysics  penelope
#
/gun/particle e-
/gun/energy 15 keV
#
# 0 degree
/gun/direction 1.0  0.0  0.0
# 60 degree
#/gun/direction 0.5  0.0  0.866025404
#
/testem/phys/setCuts 0.0001 mm
#
/run/initialize
/run/beamOn 300000
