/// \file RunAction.icc
/// \brief Implementation of the inline functions of RunAction class

#include "G4AccumulableManager.hh"

//_____________________________________________________________________________
inline G4bool RunAction::Check(G4VAccumulable* accumulable, const G4String& message) const
{
  if (accumulable == nullptr)
  {
    G4cout << message << " failed." << G4endl;
    return false;
  }

  return true;
}

//_____________________________________________________________________________
inline G4int RunAction::GetId(G4VAccumulable* accumulable, G4String& message) const
{
  const auto& id = accumulable->GetId();
  message += "accumulable by id " + std::to_string(id);

  return id;
}

//_____________________________________________________________________________
inline void RunAction::TestGetById()
{
  // test acces functions
  //

  G4bool result = true;

  // Error message
  G4String message0 = "Get ";

  auto accumulableManager = G4AccumulableManager::Instance();

  // Accumulables of value G4double type
  for (auto acc : fDValues)
  {
    G4String message = message0 + "value";
    auto tid = GetId(acc, message);
    auto retrievedAcc = accumulableManager->GetAccValue<G4double>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of value G4int type
  {
    G4String message = message0 + "value";
    auto tid = GetId(&fNsec, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccValue<G4int>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of value G4bool type
  {
    G4String message = message0 + "value";
    auto tid = GetId(&fPassed, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccValue<G4bool>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of array type
  for (auto acc : fArrays)
  {
    G4String message = message0 + "value";
    auto tid = GetId(acc, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccArray<G4double, 2>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of vector type
  for (auto acc : fVectors)
  {
    G4String message = message0 + "value";
    auto tid = GetId(acc, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccVector<G4double>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of map type
  for (auto acc : fMaps)
  {
    G4String message = message0 + "value";
    auto tid = GetId(acc, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccMap<G4String, G4int>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of map type
  for (auto acc : fUnorderedMaps)
  {
    G4String message = message0 + "unordered maps";
    ;
    auto tid = GetId(acc, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccUnorderedMap<G4String, G4int>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Print test result
  if (result)
  {
    G4cout << "Test get by Id finished successfully." << G4endl;
  }
  else
  {
    G4cout << "Test get by Id failed." << G4endl;
  }
}

//_____________________________________________________________________________
inline G4String RunAction::GetName(G4VAccumulable* accumulable, G4String& message) const
{
  const auto& name = accumulable->GetName();
  message += "accumulable by name " + name;

  return name;
}

//_____________________________________________________________________________
inline void RunAction::TestGetByName()
{
  // test acces functions
  //

  G4bool result = true;

  // Error message
  G4String message0 = "Get ";

  auto accumulableManager = G4AccumulableManager::Instance();

  // Accumulables of value G4double type
