  }

  // Accumulables of value G4bool type
  {
    G4String message = message0 + "value";
    auto tid = GetName(&fPassed, message);
    ;
    auto retrievedAcc = accumulableManager->GetAccValue<G4bool>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of array type
  for (auto acc : fArrays)
  {
    G4String message = message0 + "value";
    auto tid = GetName(acc, message);
    auto retrievedAcc = accumulableManager->GetAccArray<G4double, 2>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of vector type
  for (auto acc : fVectors)
  {
    G4String message = message0 + "value";
    auto tid = GetName(acc, message);
    auto retrievedAcc = accumulableManager->GetAccVector<G4double>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of map type
  for (auto acc : fMaps)
  {
    G4String message = message0 + "value";
    auto tid = GetName(acc, message);
    auto retrievedAcc = accumulableManager->GetAccMap<G4String, G4int>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Accumulables of map type
  for (auto acc : fUnorderedMaps)
  {
    G4String message = message0 + "unordered maps";
    ;
    auto tid = GetName(acc, message);
    auto retrievedAcc = accumulableManager->GetAccUnorderedMap<G4String, G4int>(tid);
    result &= Check(retrievedAcc, message);
  }

  // Print test result
  if (result)
  {
    G4cout << "Test get by Name finished successfully." << G4endl;
  }
  else
  {
    G4cout << "Test get by Name failed." << G4endl;
  }
}
