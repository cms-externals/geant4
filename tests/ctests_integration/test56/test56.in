#
# macro file for test56
#
/control/verbose 1
/control/cout/ignoreThreadsExcept 0
/run/verbose 1
/tracking/verbose 0
#
/testem/det/setMat G4_Cu
#/testem/det/setSize 1 cm
/testem/det/setSize 0.01 mm
#
/testem/phys/addPhysics emstandard_opt2
#/testem/phys/addPhysics emlivermore
#/testem/phys/addPhysics empenelope
#
/run/setCut 0.0003 mm
#
/process/eLoss/CSDARange true
/run/initialize

/testem/stack/killSecondaries false
#/testem/phys/fluo true
/process/em/deexcitation World true true true
/process/em/fluo true
/process/em/auger true
/process/em/pixe true
#/process/em/pixeXSmodel ECPSSR_Analytical
#/testem/phys/pixe true
#
/gun/particle proton
/gun/energy 10 MeV
# 
/analysis/setFileName proton10mev_auger2
#/analysis/h1/set 4 80  0 10 keV  #e- energy spectrum
/analysis/h1/set 4 200 0 10  keV  #e- energy spectrum
/analysis/h1/set 5 200 0 10  keV  #g energy spectrum
#
/run/beamOn 10000
#
