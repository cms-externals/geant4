#
# macro file for Test53.cc
#
/control/verbose 2
/control/cout/ignoreThreadsExcept 0
/run/verbose 2
#
/testem/det/setAbsMat Silicon
/testem/det/setAbsThick 20 um
/testem/det/setAbsYZ    50 um
#
#/testem/phys/addPhysics  empenelope
#/testem/phys/addPhysics  emlivermore
#/testem/phys/addPhysics  emstandard
#/testem/phys/addPhysics  emstandard_opt3
/testem/phys/addPhysics  standardGS
#
/testem/phys/setCuts 7 um
#
/process/em/verbose 1
#
/run/initialize
#
/testem/gun/setDefault
/gun/particle e- 
/gun/energy 100 MeV
#
/analysis/setFileName test54
/analysis/h1/set 13 100 -0.25 0.25 mrad 
#
/run/beamOn 100000
#
/testem/det/setAbsMat Gold
/testem/det/setAbsThick 9.658 um
/testem/det/setAbsYZ    1 mm
#
/run/initialize
#
/testem/gun/setDefault
/gun/particle e-
/gun/energy 15.7 MeV
/run/beamOn 100000
#
/testem/phys/setCuts 10 um
#
