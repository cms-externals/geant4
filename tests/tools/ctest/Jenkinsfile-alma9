//
// This pipeline is running the nightly build and testing for alma9/el9 platform
// - It defines the matrix of combinations to run: compiler, MT mode
// - Some optional builds are included.
//
// Gunter Folger, June 2023
//

def g4

pipeline {
  parameters {
    choice(name: 'MODE',
           choices: ['nightly', 'experimental', 'release', 'physicschecks', 'patch'] ,
           description: 'set the build mode for CMake')
    choice(name: 'BUILDTYPE',
           choices: ['RelWithDebInfo', 'Release', 'Debug', 'FullRelWithDebInfo'] ,
           description: 'Value for CMAKE_BUILD_TYPE, allowed values are those allowed in CMake')
    string(name: 'EXTERNALS',
           defaultValue: '',
           description: 'CVMFS directory keeping the external libraries, leave blank to use default')
    string(name: 'BuildOptions',
           defaultValue: '',
           description: 'extra build options, like: staticlibs, UseUsolids, BoundsCheck, EpCheck, UseInternalCLHEP, UseGranularCLHEP, MemCheck (valgrind), ....  Combinations allowed, separate options by comma: ,')
    string(name: 'ExtraCMakeOptions',
           defaultValue: '',
           description: 'Additional CMake configuration options of the form "-Doption1=value1 -Doption2=value2"')
    string(name: 'SourceBranch',
           defaultValue: 'stage/master/nightly',
           description: 'branch to checkout')
    string(name: 'VerificationSourceBranch',
           defaultValue: 'stage/master/nightly',
           description: '')
    string(name: 'BenchmarksSourceBranch',
           defaultValue: 'stage/master/nightly',
           description: '')
  }

  options {
    buildDiscarder(logRotator( daysToKeepStr: '14' ))
    timestamps()
  }

  environment {
    OS= 'alma9'
  }

  agent {label 'startup-jobs'}
  stages {
    stage('load functions') {
      steps {
        script{
          g4 = load 'scripts/tests/tools/ctest/JenkinsFunctions.groovy'
        }
      }
    }

    stage('DefautBuildAndTest') {
      matrix {
        axes {
          axis {
            name 'COMPILER'
            values 'native', 'gcc12', 'gcc13', 'gcc14', 'gcc15', 'gcc16', 'clang19', 'clang20', 'icpx'
          }
          axis {
            name 'THREAD'
            values 'Seq', 'MT','MTmax'
	  }
        }
        excludes {
          exclude {
            axis {
              name 'THREAD'
              values 'MT'
            }
          }
        }

        stages {
          stage('Run build jobs') {
            steps {
              script{
                println "${OS}" + " : " + "${COMPILER}" + " : " + "${THREAD}"
                g4.doBuild()
              }
            }
          }
        }
      }
    }

    stage('extraBuildAndTest') {
      steps {
        script{
          g4.doOptionalBuilds("${OS}", 'native', 'MTmax', ['RM_Serial','RM_TBB', 'RM_MT'])
	  
          g4.doOptionalBuilds("${OS}", 'gcc14',  'MTmax', ['UseVTK', 'RM_TBB', 'UseVecGeom'])
	  
          g4.doOptionalBuilds("${OS}", 'gcc15',  'MTmax', ['RM_Serial','RM_TBB', 'RM_MT'])
          g4.doOptionalBuilds("${OS}", 'gcc15',  'MTmax', ['UseLTO', 'UseVecGeom', 'UseVTK', 'TestExampleGuidelines'])
          g4.doOptionalBuilds("${OS}", 'gcc15',  'MTmax', ['EpCheck', 'BoundsCheck,UseInternalCLHEP,noView',  'MemCheck'])
          g4.doOptionalBuilds("${OS}", 'gcc15',  'MTmax', ['CXX23,noView'])
	  g4.doOptionalBuilds('g4-alma9', 'gcc15'  ,'Seq'  , ['staticlibs'])
	  g4.doOptionalBuilds('g4-alma9', 'gcc15'  ,'MTmax', ['staticlibs'])
	  
          withEnv(['Buildtype=Release']) {
             g4.doOptionalBuilds("${OS}", 'gcc14'  ,'MTmax', ['none'])
             g4.doOptionalBuilds("${OS}", 'gcc15'  ,'MTmax', ['none'])
          }
          withEnv(['Buildtype=Debug']) {
             g4.doOptionalBuilds("${OS}", 'gcc15'  ,'MTmax', ['none'])
          }
          withEnv(['Buildtype=FullRelWithDebInfo']) {
             g4.doOptionalBuilds("${OS}", 'gcc14'  ,'MTmax', ['none'])
             g4.doOptionalBuilds("${OS}", 'gcc15'  ,'MTmax', ['none'])
          }
        }
      }
    }
  }
}
