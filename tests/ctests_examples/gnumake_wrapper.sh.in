#!/bin/bash
# Wrapper around running GNUmake-based Geant4 commands/examples
# Repoint workdir under our build dir for clarity and no overriding
export G4WORKDIR=@PROJECT_BINARY_DIR@/GNUMakeBuildProducts
# Verbose output from GNUmake for debugging
export CPPVERBOSE=1
source @PROJECT_BINARY_DIR@/geant4make.sh

exec "$@"
