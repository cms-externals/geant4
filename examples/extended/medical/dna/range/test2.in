#
/run/numberOfThreads 1
/tracking/verbose 1
#
/range/det/setMat G4_WATER
/range/det/setRadius 1 m
#
/range/det/setTrackingCut 0.001 eV
#/range/det/setTrackingCut 10 eV
#
/range/phys/addPhysics  dna_opt2
#/process/eLoss/maxKinEnergy 0.5 GeV
#
#/process/em/lowestEnergy 1 MeV
/run/initialize
#
#/gun/particle proton
#
#/gun/particle e-
#/gun/particle proton
#/gun/particle hydrogen
#/gun/particle alpha
#/gun/particle alpha+
#/gun/particle helium
#
/process/inactivate e-_G4DNAElectronSolvation
/process/inactivate e-_G4DNAElastic
/process/inactivate e-_G4DNAExcitation
/process/inactivate e-_G4DNAIonisation
/process/inactivate e-_G4DNAAttachment
/process/inactivate e-_G4DNAVibExcitation
#
/gun/particle proton
/gun/energy 400 MeV
#/run/beamOn 1
#
/gun/particle alpha
/gun/energy 400 MeV
#/run/beamOn 1
#
/gun/particle ion
/gun/ion 14 28
/gun/energy 7300 MeV
#/run/beamOn 1
/gun/energy 8500 MeV
/run/beamOn 1
