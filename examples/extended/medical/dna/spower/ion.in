#
/control/verbose 1
/control/cout/ignoreThreadsExcept 0
/run/numberOfThreads 8
/run/verbose 1
#
/spower/det/setMat G4_WATER
/spower/det/setRadius 1 m
/process/eLoss/maxKinEnergy 600 MeV
#
# Register physics constructor
#/spower/phys/addPhysics  dna_stat
/spower/phys/addPhysics  dna_stat_opt2
#/spower/phys/addPhysics  dna_stat_opt4
#/spower/phys/addPhysics  dna_stat_opt6
#
/run/initialize
/process/inactivate nuclearStopping
#
/tracking/verbose 0
#
/gun/particle ion
/gun/ion 3 7
#
/gun/energy 7 keV
/run/beamOn 10000
#
/gun/energy 70 keV
/run/beamOn 10000
#
/gun/energy 700 keV
/run/beamOn 10000
#
/gun/energy 1.4 MeV
/run/beamOn 10000
#
/gun/energy 7 MeV
/run/beamOn 10000
#
/gun/energy 70 MeV
/run/beamOn 10000
