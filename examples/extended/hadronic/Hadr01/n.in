/control/verbose 2
/run/verbose 2
/tracking/verbose 0
#
/testhadr/TargetMat        G4_H
/testhadr/TargetRadius     100000 cm
/testhadr/TargetLength     100000 cm
/testhadr/NumberDivZ       100
/testhadr/PrintModulo      10
#
/run/setCut                1 mm
#
/run/initialize
#
/gun/particle neutron
/gun/energy 30. MeV
/run/beamOn 100
#
