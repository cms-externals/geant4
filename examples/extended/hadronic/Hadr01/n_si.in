/control/verbose 2
/run/verbose 1
/tracking/verbose 0
#
/testhadr/TargetMat        G4_Si
/testhadr/TargetRadius     100 cm
/testhadr/TargetLength     100 cm
/testhadr/NumberDivZ       100
/testhadr/PrintModulo      100
#
/run/setCut                1 mm
#/testhadr/Physics         QBBC
#
/run/initialize
#
/gun/particle neutron
#/gun/particle ion
#/gun/ion 6 12
/gun/energy 14.1 MeV
/run/beamOn 10000
