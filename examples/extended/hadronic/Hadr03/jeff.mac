#
# Macro file for "Hadr03.cc"
#
/control/verbose 2
/run/verbose 2
#
/testhadr/det/setIsotopeMat H1 1 1 0.09 g/cm3
/testhadr/det/setSize 10 m
#
/run/initialize
#
/gun/particle neutron
/gun/energy 25 meV
#
/process/inactivate hadElastic
#
/analysis/setFileName jeff2
/analysis/h1/set 2  100  0. 3. MeV      #gamma
#
/run/printProgress 10000
/run/beamOn 100000
