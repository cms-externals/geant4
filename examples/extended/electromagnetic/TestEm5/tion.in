#
# macro file for TestEm5.cc
#
/control/verbose 2
/control/cout/ignoreThreadsExcept 0
/tracking/verbose 0
/run/numberOfThreads 1
/run/verbose 1
#
#/testem/det/setAbsMat G4_Ti
#/testem/det/setAbsThick 1.5 um
/testem/det/setAbsMat G4_Pu
#/testem/det/setAbsMat G4_U
#/testem/det/setAbsMat PuO2
#/testem/det/setAbsMat G4_PbWO4
/testem/det/setAbsThick 0.7 um
/testem/det/setAbsYZ    5 cm
#
/testem/phys/addPhysics emstandard_opt0
#/testem/phys/addPhysics emstandard_opt3
#/testem/phys/addPhysics emstandard_opt4
#/process/em/verbose 1
#/process/em/workerVerbose 0
#
/run/setCut 0.001 mm
#
/run/initialize
#
/testem/gun/setDefault
/gun/particle ion
/gun/ion 22 50
/gun/energy 280 MeV
#
/run/printProgress 10000
/run/beamOn 100
#
#/control/shell mkdir physdata3
#/run/particle/storePhysicsTable physdata3
#
