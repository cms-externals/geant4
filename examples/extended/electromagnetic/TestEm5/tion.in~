#
# macro file for TestEm5.cc
#
/control/verbose 2
/control/cout/ignoreThreadsExcept 0
/tracking/verbose 0
/run/numberOfThreads 1
/run/verbose 1
#
/testem/det/setAbsMat G4_MYLAR
/testem/det/setAbsThick 0.01 mm
/testem/det/setAbsYZ    5 cm
#
/testem/phys/addPhysics  emstandard_opt3
/process/em/verbose 1
/process/em/workerVerbose 0
#
/run/setCut 0.01 mm
#
/run/initialize
#
/testem/gun/setDefault
/gun/particle pi+
/gun/energy 2 MeV
#
/run/printProgress 10000
/run/beamOn 1000
#
