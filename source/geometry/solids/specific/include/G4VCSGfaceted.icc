inline G4VCSGfaceted::G4StackVisited::G4StackVisited(G4int entries)
{
  // Keep the usual face set on the stack and allocate only for large solids.
  const auto words = std::size_t((entries + 63) / 64);
  if (words > fStack.size())
  {
    fHeap.assign(words, 0);
  }
}

inline G4bool G4VCSGfaceted::G4StackVisited::TestAndSet(G4int i)
{
  const auto word = std::size_t(i) >> 6;
  const auto mask = 1ULL << (std::size_t(i) & 63U);
  auto& entry = fHeap.empty() ? fStack[word] : fHeap[word];
  const G4bool visited = (entry & mask) != 0;
  entry |= mask;
  return visited;
}

inline G4bool G4VCSGfaceted::HasZSectionIndex() const
{
  return numFace >= kMinZSectionIndexFaces && G4int(fZSectionMin.size()) == numFace
         && G4int(fZSectionMax.size()) == numFace && !fZSlabCandidate.empty();
}

inline G4bool
G4VCSGfaceted::FaceCanImprovePoint(G4int i, G4double z,
                                   G4double best, G4double tolerance) const
{
  if (best == kInfinity)
  {
    return true;
  }

  G4double dz = 0.;
  if (z < fZSectionMin[i])
  {
    dz = fZSectionMin[i] - z;
  }
  else if (z > fZSectionMax[i])
  {
    dz = z - fZSectionMax[i];
  }
  return dz <= best + tolerance;
}

inline G4bool
G4VCSGfaceted::RayIntersectsFaceZ(G4int i, const G4ThreeVector& p, const G4ThreeVector& v,
                                  G4double best, G4double tolerance,
                                  G4bool radialCull) const
{
  const G4double zMin = fZSectionMin[i] - tolerance;
  const G4double zMax = fZSectionMax[i] + tolerance;
  const G4double z = p.z();
  const G4double vz = v.z();

  G4double t0 = 0.;
  G4double t1 = best;
  if (std::fabs(vz) < DBL_MIN)
  {
    if (z < zMin || z > zMax) return false;
  }
  else
  {
    G4double s1 = (zMin - z) / vz;
    G4double s2 = (zMax - z) / vz;
    if (s1 > s2) std::swap(s1, s2);
    if (s2 < -tolerance || (best != kInfinity && s1 > best + tolerance))
    {
      return false;
    }
    t0 = std::max(0., s1);
    t1 = std::min(best, s2);
  }

  if (radialCull && i < G4int(fRSectionMax.size()) && t0 <= t1)
  {
    if (RayMissesRadialLimit(p, v, t0, t1,
                             fRSectionMax[i] + tolerance)) return false;
  }
  return true;
}

inline G4bool G4VCSGfaceted::RayMissesRadialLimit(
  const G4ThreeVector& p, const G4ThreeVector& v, G4double t0, G4double t1,
  G4double radialLimit)
{
  const G4double vxy2 = v.x() * v.x() + v.y() * v.y();
  G4double tMin = t0;
  if (vxy2 > 0.)
  {
    tMin = std::max(t0, std::min(t1,
      -(p.x() * v.x() + p.y() * v.y()) / vxy2));
  }
  const G4double x = p.x() + tMin * v.x();
  const G4double y = p.y() + tMin * v.y();
  return x * x + y * y > radialLimit * radialLimit;
}

inline EInside G4VCSGfaceted::CombineInside(EInside rz, EInside phi)
{
  if (rz == kOutside || phi == kOutside) return kOutside;
  return (rz == kSurface || phi == kSurface) ? kSurface : kInside;
}

inline EInside G4VCSGfaceted::InsideNoZ(const G4ThreeVector& p) const
{
  EInside answer = kOutside;
  G4VCSGface** face = faces;
  G4double best = kInfinity;
  const G4double tolerance = kCarTolerance / 2;

  do  // Loop checking, 13.08.2015, G.Cosmo
  {
    G4double distance;
    EInside result = (*face)->Inside(p, tolerance, &distance);
    if (result == kSurface)
    {
      return kSurface;
    }
    if (distance < best)
    {
      best = distance;
      answer = result;
    }
  } while (++face < faces + numFace);

  return answer;
}

inline EInside G4VCSGfaceted::InsideZ(const G4ThreeVector& p) const
{
  EInside answer = kOutside;
  G4double best = kInfinity;
  const G4double tolerance = kCarTolerance / 2;
  const G4double z = p.z();
  const auto& candidates = GetZCandidates(z);

  if (candidates.empty())
  {
    return InsideNoZ(p);
  }

  for (auto i : fZGlobalCandidate)
  {
    G4double distance;
    EInside result = faces[i]->Inside(p, tolerance, &distance);
    if (result == kSurface)
    {
      return kSurface;
    }
    if (distance < best)
    {
      best = distance;
      answer = result;
    }
  }

  for (auto i : candidates)
  {
    G4double distance;
    EInside result = faces[i]->Inside(p, tolerance, &distance);
    if (result == kSurface)
    {
      return kSurface;
    }
    if (distance < best)
    {
      best = distance;
      answer = result;
    }
  }
  return answer;
}

inline std::unique_ptr<G4VCSGfaceted::G4ZCandidateData>
G4VCSGfaceted::CopyZCandidateData(const std::unique_ptr<G4ZCandidateData>& source)
{
  return source == nullptr ? nullptr : std::make_unique<G4ZCandidateData>(*source);
}

inline std::unique_ptr<G4VCSGfaceted::G4ZCandidateData>
G4VCSGfaceted::MakeZCandidateData(G4int nFace)
{
  // Candidate indexing does not amortise its storage cost for small solids.
  return nFace >= kMinZSectionIndexFaces ? std::make_unique<G4ZCandidateData>() : nullptr;
}

inline std::size_t G4VCSGfaceted::GetZSlabIndex(G4double z) const
{
  return FindZSlabIndex(fZSlabBoundary, z);
}

template <typename Corner>
G4bool G4VCSGfaceted::HasRZEdge(const Corner& a, const Corner& b)
{
  return !(a.r < 1 / kInfinity && b.r < 1 / kInfinity);
}

template <typename Section, typename Corner>
G4bool G4VCSGfaceted::InitRZSection(Section& section, const Corner& a,
                                   const Corner& b)
{
  section.r0 = a.r;
  section.z0 = a.z;
  section.r1 = b.r;
  section.z1 = b.z;
  const G4double dr = section.r1 - section.r0;
  const G4double dz = section.z1 - section.z0;
  section.length = std::sqrt(dr * dr + dz * dz);
  if (section.length <= 0.)
  {
    return false;
  }
  section.rS = dr / section.length;
  section.zS = dz / section.length;
  section.rNorm = section.zS;
  section.zNorm = -section.rS;
  section.zMin = std::min(section.z0, b.z);
  section.zMax = std::max(section.z0, b.z);
  return true;
}

template <typename Section>
void G4VCSGfaceted::AddRZSectionCandidate(const Section& section,
                                          std::vector<Section>& sections,
                                          G4ZCandidateData* data) const
{
  sections.push_back(section);
  if (data != nullptr && section.zMax - section.zMin <= kCarTolerance)
  {
    // Keep horizontal edges available to the normal and ray traversals.
    data->global.push_back(G4int(sections.size()) - 1);
  }
}

template <typename Section>
void G4VCSGfaceted::BuildRZVoxel(const std::vector<Section>& sections,
                                 std::unique_ptr<G4ZCandidateData>& data) const
{
  if (data != nullptr)
  {
    BuildZVoxelizer(sections, 10. * kCarTolerance, data->boundary, data->candidate);
    data->rMax.assign(data->candidate.size(), -kInfinity);
    data->maxRadius = 0.;
    data->bounds.clear();
    data->safetyOrder.clear();
    data->safetyZMax.clear();
    for (std::size_t slab = 0; slab < data->candidate.size(); ++slab)
    {
      for (auto i : data->candidate[slab])
      {
        const auto& sec = sections[i];
        data->rMax[slab] = std::max(data->rMax[slab], std::max(sec.r0, sec.r1));
        data->maxRadius = std::max(data->maxRadius, data->rMax[slab]);
      }
    }
    if (sections.size() > 66)
    {
      // Keep the contour order: neighbouring sections usually have tight bounds.
      // Leaves occupy [n, 2*n); each internal node bounds its two children.
      const std::size_t n = sections.size();
      data->bounds.resize(2 * n);
      for (std::size_t i = 0; i < n; ++i)
      {
        const auto& sec = sections[i];
        data->bounds[n + i] = {std::min(sec.r0, sec.r1), std::max(sec.r0, sec.r1),
                               sec.zMin, sec.zMax};
      }
      for (std::size_t i = n; i-- > 1;)
      {
        const auto& a = data->bounds[2 * i];
        const auto& b = data->bounds[2 * i + 1];
        data->bounds[i] = {std::min(a[0], b[0]), std::max(a[1], b[1]),
                           std::min(a[2], b[2]), std::max(a[3], b[3])};
      }
    }
    else if (sections.size() > 16)
    {
      // A prefix bound also covers generic contours whose edges overlap in Z.
      const std::size_t n = sections.size();
      data->safetyOrder.resize(n);
      for (std::size_t i = 0; i < n; ++i) { data->safetyOrder[i] = G4int(i); }
      std::sort(data->safetyOrder.begin(), data->safetyOrder.end(),
        [&](G4int a, G4int b) { return sections[a].zMin < sections[b].zMin; });
      data->safetyZMax.resize(n);
      G4double zMax = -kInfinity;
      for (std::size_t i = 0; i < n; ++i)
      {
        zMax = std::max(zMax, sections[data->safetyOrder[i]].zMax);
        data->safetyZMax[i] = zMax;
      }
    }
  }
}

template <typename Section>
inline G4double G4VCSGfaceted::DistanceToRZSections(
  G4double radius, G4double z, const std::vector<Section>& sections,
  const std::unique_ptr<G4ZCandidateData>& data, G4bool outgoing,
  G4double metricScale) const
{
  const G4double normSign = outgoing ? -1. : 1.;
  G4double best = kInfinity;
  G4double boundLimit = kInfinity;
  auto check = [&](G4int i)
  {
    const auto& sec = sections[i];
    G4double dzBound = 0.;
    if (z < sec.zMin)
    {
      dzBound = sec.zMin - z;
    }
    else if (z > sec.zMax)
    {
      dzBound = z - sec.zMax;
    }
    if (dzBound > boundLimit)
    {
      return;
    }
    const G4double dr = radius - sec.r0;
    const G4double dz = z - sec.z0;
    const G4double q = dr * sec.rS + dz * sec.zS;
    const G4double norm = dr * sec.rNorm + dz * sec.zNorm;
    if (normSign * norm <= -0.5 * kCarTolerance)
    {
      return;
    }
    G4double distOut2 = 0.;
    if (q < 0.)
    {
      distOut2 = q * q;
    }
    else if (q > sec.length)
    {
      distOut2 = (q - sec.length) * (q - sec.length);
    }
    const G4double d = distOut2 > 0.
      ? std::sqrt(norm * norm + distOut2) : std::fabs(norm);
    if (d < best)
    {
      best = d;
      // Bounds and segment distances round differently at large coordinates.
      boundLimit = best + kCarTolerance
        + 8. * DBL_EPSILON * std::max({std::fabs(radius), std::fabs(z), best});
    }
  };

  if (sections.size() > 66 && data != nullptr && !data->bounds.empty())
  {
    auto bound = [&](std::size_t i)
    {
      const auto& box = data->bounds[i];
      const G4double dr = std::max({box[0] - radius, 0., radius - box[1]});
      const G4double dz = std::max({box[2] - z, 0., z - box[3]});
      return dr * dr + dz * dz;
    };
    // Visit the nearer child first to establish a tight bound. The existing
    // signed segment distance remains the authority at every leaf.
    auto visit = [&](auto&& self, std::size_t i, G4double lower) -> void
    {
      if (lower > boundLimit * boundLimit || best <= 0.) { return; }
      if (i >= sections.size())
      {
        check(G4int(i - sections.size()));
        return;
      }
      std::size_t a = 2 * i, b = a + 1;
      G4double da = bound(a), db = bound(b);
      if (db < da)
      {
        std::swap(a, b);
        std::swap(da, db);
      }
      self(self, a, da);
      self(self, b, db);
    };
    visit(visit, 1, bound(1));
  }
  else if (outgoing && data != nullptr && !data->safetyOrder.empty())
  {
    const auto& order = data->safetyOrder;
    const auto first = std::upper_bound(order.begin(), order.end(), z,
      [&](G4double value, G4int i) { return value < sections[i].zMin; });
    // Establish a local bound before visiting more distant edges. Prefix
    // maxima allow an early stop even for overlapping/non-monotonic contours.
    for (auto i = first; i != order.begin();)
    {
      --i;
      if (z - data->safetyZMax[i - order.begin()] > boundLimit) { break; }
      check(*i);
    }
    for (auto i = first; i != order.end(); ++i)
    {
      if (sections[*i].zMin - z > boundLimit) { break; }
      check(*i);
    }
  }
  else
  {
    for (G4int i = 0; i < G4int(sections.size()); ++i)
    {
      check(i);
    }
  }
  // The R coordinate may be a scaled projection, as for G4Polyhedra.
  // Multiplication by the minimum metric scale converts the distance in
  // the R/Z parameter space into a conservative Cartesian safety.
  return metricScale * best;
}

template <typename Section>
inline EInside G4VCSGfaceted::InsideRZSections(
  G4double radius, G4double z, const std::vector<Section>& sections,
  const std::unique_ptr<G4ZCandidateData>& data) const
{
  if (sections.empty()) { return kOutside; }
  const G4double tol = 0.5 * kCarTolerance;
  G4bool inside = false;

  auto check = [&](G4int i)
  {
    const auto& sec = sections[i];
    const G4double dr = radius - sec.r0;
    const G4double dz = z - sec.z0;
    const G4double q = std::max(0., std::min(sec.length,
                              dr * sec.rS + dz * sec.zS));
    const G4double rr = dr - q * sec.rS;
    const G4double zz = dz - q * sec.zS;
    if (rr * rr + zz * zz <= tol * tol) { return true; }

    // Half-open parity crossing avoids double counting polygon vertices and
    // is independent of convexity and polygon winding.
    if ((sec.z0 > z) != (sec.z1 > z))
    {
      const G4double crossing = sec.r0
        + (z - sec.z0) * (sec.r1 - sec.r0) / (sec.z1 - sec.z0);
      if (radius < crossing) { inside = !inside; }
    }
    return false;
  };

  if (data != nullptr && !data->candidate.empty())
  {
    // Horizontal edges are included in tolerance-expanded slabs too.
    for (auto i : FindZCandidates(data->boundary, data->candidate, z))
    {
      if (check(i)) { return kSurface; }
    }
  }
  else
  {
    for (G4int i = 0; i < G4int(sections.size()); ++i)
    {
      if (check(i)) { return kSurface; }
    }
  }
  return inside ? kInside : kOutside;
}

inline EInside G4VCSGfaceted::PhiState(G4bool phiIsOpen,
                                       G4double startPhi, G4double endPhi,
                                       G4double sStart, G4double cStart,
                                       G4double sEnd, G4double cEnd,
                                       const G4ThreeVector& p) const
{
  if (!phiIsOpen)
  {
    return kInside;
  }
  if (p.x() == 0. && p.y() == 0.)
  {
    return kSurface;
  }
  const G4double tol = 0.5 * kCarTolerance;
  const G4double crossStart = cStart * p.y() - sStart * p.x();
  const G4double crossEnd = p.x() * sEnd - p.y() * cEnd;
  const G4bool shortSection = (endPhi - startPhi) <= CLHEP::pi;
  const G4bool inside = shortSection ? (crossStart >= -tol && crossEnd >= -tol)
                                     : (crossStart >= -tol || crossEnd >= -tol);
  if (!inside)
  {
    return kOutside;
  }
  return (std::fabs(crossStart) <= tol || std::fabs(crossEnd) <= tol)
         ? kSurface : kInside;
}

inline G4double G4VCSGfaceted::DistanceToPhiBoundary(
  G4bool phiIsOpen, G4double sStart, G4double cStart,
  G4double sEnd, G4double cEnd, const G4ThreeVector& p,
  G4ThreeVector* normal) const
{
  if (!phiIsOpen)
  {
    return kInfinity;
  }
  const G4double dStart = std::fabs(cStart * p.y() - sStart * p.x());
  const G4double dEnd = std::fabs(p.x() * sEnd - p.y() * cEnd);
  if (dStart <= dEnd)
  {
    if (normal != nullptr)
    {
      normal->set(sStart, -cStart, 0.);
    }
    return dStart;
  }
  if (normal != nullptr)
  {
    normal->set(-sEnd, cEnd, 0.);
  }
  return dEnd;
}

template <typename Visit>
G4bool G4VCSGfaceted::VisitZSlabsBySafety(const std::vector<G4double>& boundaries,
                                          G4double z, const G4double& best,
                                          G4double tolerance, Visit&& visit)
{
  if (boundaries.size() < 2)
  {
    return false;
  }

  const std::size_t firstSlab = FindZSlabIndex(boundaries, z);
  const std::size_t nSlab = boundaries.size() - 1;
  for (std::size_t offset = 0; offset < nSlab; ++offset)
  {
    G4bool any = false;
    if (firstSlab >= offset)
    {
      const auto slab = firstSlab - offset;
      const G4double dzBound = (z < boundaries[slab])
        ? boundaries[slab] - z
        : (z > boundaries[slab + 1] ? z - boundaries[slab + 1] : 0.);
      if (dzBound <= best + tolerance)
      {
        any = true;
        if (visit(slab))
        {
          return true;
        }
      }
    }
    if (firstSlab + offset < nSlab && offset != 0)
    {
      const auto slab = firstSlab + offset;
      const G4double dzBound = (z < boundaries[slab])
        ? boundaries[slab] - z
        : (z > boundaries[slab + 1] ? z - boundaries[slab + 1] : 0.);
      if (dzBound <= best + tolerance)
      {
        any = true;
        if (visit(slab))
        {
          return true;
        }
      }
    }
    if (!any && offset != 0)
    {
      break;
    }
  }
  return false;
}

template <typename Section>
void G4VCSGfaceted::BuildZVoxelizer(const std::vector<Section>& sections,
                                    G4double minHalfZ, std::vector<G4double>& slabBoundary,
                                    std::vector<std::vector<G4int>>& slabCandidate)
{
  std::vector<G4double> zMin;
  std::vector<G4double> zMax;
  zMin.reserve(sections.size());
  zMax.reserve(sections.size());
  for (const auto& sec : sections)
  {
    zMin.push_back(sec.zMin);
    zMax.push_back(sec.zMax);
  }
  BuildZVoxelizer(zMin, zMax, minHalfZ, slabBoundary, slabCandidate);
}
