//
// ClassName:   G4CompetativeMF
//
// Authors: N. Chalyi & V.Ivanchenko 
//
// Class description:
//
// Model of the nuclear multifragmentation. It considers decay with
// emission of neutrons, protons, or light ions, and nuclear fission.
//

#ifndef G4COMPETATIVEMF_hh
#define G4COMPETATIVEMF_hh

#include "G4VMultiFragmentation.hh"
#include "G4FragmentVector.hh"
#include "G4Fragment.hh"
#include "G4VEvaporationChannel.hh"
#include <vector>

class G4ExcitationHandler;

class G4CompetativeMF : public G4VMultiFragmentation
{
public:
  G4CompetativeMF(G4ExcitationHandler* handler);
  ~G4CompetativeMF() override = default;
    
  G4FragmentVector* BreakItUp(const G4Fragment& theFragment) override;

  G4CompetativeMF(const G4CompetativeMF& right) = delete;
  G4CompetativeMF& operator=(const G4CompetativeMF& right) = delete;
  G4bool operator==(const G4CompetativeMF& right) = delete;
  G4bool operator!=(const G4CompetativeMF& right) = delete;

private:

  G4ExcitationHandler* fHandler;
  std::size_t fNn;
  std::vector<G4VEvaporationChannel*> fChannels;
  std::vector<G4double> probabilities;
};

#endif
