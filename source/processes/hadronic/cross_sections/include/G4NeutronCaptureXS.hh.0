// Class Description:
// This is a class for neutron radiative capture cross section based on
// data files from G4PARTICLEXSDATA data set
// Class Description - End

#ifndef G4NEUTRONCAPTUREXS_HH
#define G4NEUTRONCAPTUREXS_HH

#include "G4CrossSectionXS.hh"

#include <vector>

class G4NeutronCaptureXS final : public G4CrossSectionXS
{
  public:

    G4NeutronCaptureXS();

    ~G4NeutronCaptureXS() override = default;

    static const char* Default_Name() { return "G4NeutronCaptureXS"; }

    const G4Isotope* SelectIsotope(const G4Element*, G4double ekin, G4double loge) final;

    void BuildPhysicsTable(const G4ParticleDefinition&) final;

    void CrossSectionDescription(std::ostream&) const final;

    G4double ElementCrossSection(G4double ekin, G4double loge, G4int Z) final;

    G4double IsoCrossSection(G4double ekin, G4double loge, G4int Z, G4int A) final;

    G4NeutronCaptureXS& operator=(const G4NeutronCaptureXS& right) = delete;
    G4NeutronCaptureXS(const G4NeutronCaptureXS&) = delete;

  protected:

    void Initialise(G4int Z) final;

  private:

    std::vector<G4double> temp;
    G4String subDir{"/neutron/cap"};
    G4String subDirR{"/neutron/Rcap"};

    G4bool isInitializer{false};

    static G4ElementData* data;
    static G4ElementData* dataR;
};

#endif
