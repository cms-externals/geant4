// Class Description:
// This is a class for neutron radiative capture cross section based on
// data files from G4PARTICLEXSDATA data set
// Class Description - End

#ifndef G4NEUTRONFISSIONXS_HH
#define G4NEUTRONFISSIONXS_HH

#include "G4CrossSectionXS.hh"

#include <vector>

class G4NeutronFissionXS final : public G4CrossSectionXS
{
  public:

    G4NeutronFissionXS();

    ~G4NeutronFissionXS() override = default;

    static const char* Default_Name() { return "G4NeutronFissionXS"; }

    const G4Isotope* SelectIsotope(const G4Element*, G4double kine, G4double loge) final;

    void BuildPhysicsTable(const G4ParticleDefinition&) final;

    void CrossSectionDescription(std::ostream&) const final;

    G4double ElementCrossSection(G4double kine, G4double loge, G4int Z) final;

    G4double IsoCrossSection(G4double ekin, G4double loge, G4int Z, G4int A) final;

    G4NeutronFissionXS& operator=(const G4NeutronFissionXS& right) = delete;
    G4NeutronFissionXS(const G4NeutronFissionXS&) = delete;

  protected:

    void Initialise(G4int Z) override;

private:

    G4PhysicsVector* GetVector(G4int);

    std::vector<G4double> temp;
    G4String subDir{"/neutron/fis"};
    G4String subDirR{"/neutron/Rfis"};

    static const G4int ZMINFIS = 88;
    static const G4int NZFIS = 5;
   
    static G4ElementData* data;
    static G4ElementData* dataR;
};

#endif
