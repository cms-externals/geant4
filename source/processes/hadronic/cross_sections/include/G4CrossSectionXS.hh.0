//
// GEANT4 Class header file
//
// File name:    G4CrossSectionXS
//
// Author  V. Ivanchenko 14.07.2026 
//
// Description:
// This is the base class for all XS type cross sections based on
// data files from G4PARTICLEXSDATA data set with following
// general methods:
//    1) IsApplicable(..) - is always "true", for natural materials element
//       cross sections are used, for non-natural composition of isotopes
//       isotope cross sections are called. Both element and isotope
//       cross sections should be implemeneted in the derived classes.
//    2) InitialiseOnFly(..) method is needed mainly for test application,
//       because normally data structure is initialized before run for
//       all elements involved in geometry.
//    3) CommonInit(..) method is needed to implement standard printout
//       are length of internal vector of x-sections, no check on
//       particle type, which should be correctly done in PhysicsList
//    4) Parameters:
//         pEmax - high energy limit of XS isotope cross sections, it is
//           defined by the derived class.
//         pElimit - low-energy limit of non-zero cross sections connected
//           with termal motion of the media, which is the same for all
//           materials, more accurate definition of energy limit is not
//           needed for XS cross sections.
//         pLogElimit = G4Log(pElimit).
//    5) XS data are available forf Z in interval 1-92, for higher Z the
//       Uranium data are used. 
//

#ifndef G4CROSSSECTIONXS_HH
#define G4CROSSSECTIONXS_HH

#include "G4VCrossSectionDataSet.hh"
#include "G4ElementData.hh"
#include "G4PhysicsVector.hh"
#include "globals.hh"

class G4DynamicParticle;
class G4ParticleDefinition;
class G4Element;
class G4Material;

class G4CrossSectionXS : public G4VCrossSectionDataSet
{
  public:

    explicit G4CrossSectionXS(G4double maxE, const G4String& nam);

    ~G4CrossSectionXS() override = default;

    G4bool IsElementApplicable(const G4DynamicParticle*, G4int Z,
                               const G4Material*) override;

    G4bool IsIsoApplicable(const G4DynamicParticle*, G4int Z, G4int A,
                           const G4Element*, const G4Material*) override;

    G4double GetElementCrossSection(const G4DynamicParticle*, G4int Z,
                                    const G4Material*) override;

    G4double ComputeCrossSectionPerElement(G4double kinEnergy, G4double loge,
                                           const G4ParticleDefinition*,
                                           const G4Element*,
                                           const G4Material*) override;

    G4double ComputeIsoCrossSection(G4double kinEnergy, G4double loge,
                                    const G4ParticleDefinition*,
                                    G4int Z, G4int A, const G4Isotope* iso,
                                    const G4Element* elm,
                                    const G4Material* mat) override;

    G4double GetIsoCrossSection(const G4DynamicParticle*, G4int Z, G4int A,
                                const G4Isotope* iso, const G4Element* elm,
                                const G4Material* mat) override;

    virtual G4double ElementCrossSection(G4double kinEnergy, G4double loge,
                                         G4int Z) = 0;

    virtual G4double IsoCrossSection(G4double ekin, G4double logekin,
                                     G4int Z, G4int A) = 0;

    void InitialiseOnFly(G4int Z);

    G4CrossSectionXS& operator=(const G4CrossSectionXS& right) = delete;
    G4CrossSectionXS(const G4CrossSectionXS&) = delete;

  protected:

    virtual void Initialise(G4int Z) = 0;

    void CommonInit(std::vector<G4double>& tmp, const G4ParticleDefinition&);

    G4PhysicsVector* RetrieveVector(const G4String& subdir,
                                    G4int Z, G4int A, G4bool warn);

    inline const G4PhysicsVector* GetPhysicsVector(G4int Z, G4ElementData* ptr);
  
    G4double pEmax;
    G4double pElimit;
    G4double pLogElimit;

  private:

    G4String fName;
    static G4String fDataDirectory;
};

inline const G4PhysicsVector*
G4CrossSectionXS::GetPhysicsVector(G4int Z, G4ElementData* data)
{
  const G4PhysicsVector* pv = data->GetElementData(Z);
  if (pv == nullptr)
  {
    InitialiseOnFly(Z);
    pv = data->GetElementData(Z);
  }
  return pv;
}

#endif
