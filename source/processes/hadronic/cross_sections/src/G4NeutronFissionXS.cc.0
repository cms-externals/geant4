#include "G4NeutronFissionXS.hh"

#include "G4AutoLock.hh"
#include "G4DynamicParticle.hh"
#include "G4Element.hh"
#include "G4IsotopeList.hh"
#include "G4Material.hh"
#include "G4PhysicsLogVector.hh"
#include "G4SystemOfUnits.hh"
#include "Randomize.hh"

G4ElementData* G4NeutronFissionXS::data = nullptr;
G4ElementData* G4NeutronFissionXS::dataR = nullptr;

namespace
{
G4Mutex nFissionXSMutex = G4MUTEX_INITIALIZER;
}

G4NeutronFissionXS::G4NeutronFissionXS()
  : G4CrossSectionXS(20*CLHEP::MeV,  Default_Name())
{
  verboseLevel = 0;
  if (verboseLevel > 0)
  {
    G4cout << "G4NeutronFissionXS applicable for Z >= " << ZMINFIS
           << " and energy " << pElimit/CLHEP::eV << " eV - "
           << pEmax/CLHEP::MeV << " MeV  pLogEmax=" << pLogElimit
           << G4endl;
  }
  if (nullptr == data)
  {
    G4AutoLock l(&nFissionXSMutex);
    if (nullptr == data)
    {
      data = new G4ElementData(NZFIS);
      data->SetName("nFission");
      dataR = new G4ElementData(NZFIS);
      dataR->SetName("nRFission");
      for (G4int i = 0; i < NZFIS; ++i)
      {
        Initialise(ZMINFIS + i);
      }
    }
    l.unlock();
  }
}

void G4NeutronFissionXS::CrossSectionDescription(std::ostream& outFile) const
{
  outFile << "G4NeutronFissionXS calculates the neutron fission cross sections\n"
          << "on nuclei using data from the high precision neutron database.\n"
          << "These data are simplified and smoothed over the resonance region\n"
          << "in order to reduce CPU time. G4NeutronFissionXS is set to zero\n"
          << "above 20 MeV for all targets. Cross section is non-zero for Z >= 88.\n"
          << "For Z > 92 the cross section of Uranium is used.\n";
}

G4double G4NeutronFissionXS::ElementCrossSection(G4double eKin, G4double logE, G4int Z)
{
  G4double xs = 0.0;
  G4int idx = Z - ZMINFIS;
  if (idx < 0 || idx >= NZFIS || eKin > pEmax)
  {
    return xs;
  }
  auto pv = GetVector(idx);
  if (nullptr == pv)
  {
    return xs;
  }  
  G4double ekin = eKin;
  G4double loge = logE;
  if (ekin < pElimit)
  {
    ekin = pElimit;
    loge = pLogElimit;
  }

  // data above the resonance region for an element
  G4double e0 = pv->GetMinEnergy();
  
  // data from the resonance region may exist or not
  auto pvR = dataR->GetElementData(idx);
  if (nullptr != pvR && ekin < e0)
  {
    G4double e00 = pvR->GetMinEnergy();
    xs = (ekin >= e00) ? pvR->LogVectorValue(ekin, loge)
      : (*pvR)[0] * std::sqrt(e00 / ekin);
  }
  // data above the resonance region
  else
  {
    xs = (ekin >= e0) ? pv->LogVectorValue(ekin, loge)
      : (*pv)[0] * std::sqrt(e0 / ekin);
  }

#ifdef G4VERBOSE
  if (verboseLevel > 1)
  {
    G4cout << "Ekin(MeV)= " << ekin / CLHEP::MeV << " ElmXSfis(b)= "
           << xs / CLHEP::barn << G4endl;
  }
#endif
  return xs;
}

G4double G4NeutronFissionXS::IsoCrossSection(G4double eKin, G4double logE, G4int Z, G4int A)
{
  G4double xs = 0.0;
  G4int idx = Z - ZMINFIS;
  if (idx < 0 || idx >= NZFIS || eKin > pEmax)
  {
    return xs;
  }
  auto pv = GetVector(idx);
  if (nullptr == pv)
  {
    return xs;
  }
  G4double ekin = eKin;
  G4double loge = logE;
  if (ekin < pElimit)
  {
    ekin = pElimit;
    loge = pLogElimit;
  }
  
  // data above the resonance region for an element
  G4double e0 = pv->GetMinEnergy();
  G4bool done{false};

  // data from the resonance region may exist or not
  auto pvR = dataR->GetElementData(idx);
  if (nullptr != pvR && ekin < e0)
  {
    // use isotope x-section if possible
    if (dataR->GetNumberOfComponents(idx) > 0)
    {
      auto pviso = dataR->GetComponentDataByID(idx, A);
      if (pviso != nullptr)
      {
        G4double e00 = pviso->GetMinEnergy();
        xs = (ekin >= e00) ? pviso->LogVectorValue(ekin, loge)
          : (*pviso)[0] * std::sqrt(e00 / ekin);
        done = true;
      }
    }
    // isotope data are not available or applicable
    if (!done)
    {
      G4double e00 = pvR->GetMinEnergy();
      xs = (ekin >= e00) ? pvR->LogVectorValue(ekin, loge)
        : (*pvR)[0] * std::sqrt(e00 / ekin);
    }
  }
  // data above the resonance region
  else
  {
    // use isotope x-section if possible
    if (data->GetNumberOfComponents(idx) > 0)
    {
      auto pviso = data->GetComponentDataByID(idx, A);
      if (pviso != nullptr)
      {
        G4double e00 = pviso->GetMinEnergy();
        xs = (ekin >= e00) ? pviso->LogVectorValue(ekin, loge)
          : (*pviso)[0] * std::sqrt(e00 / ekin);
        done = true;
      }
    }
    // isotope data are not available or applicable
    if (!done)
    {
      xs = (ekin >= e0) ? pv->LogVectorValue(ekin, loge)
        : (*pv)[0] * std::sqrt(e0 / ekin);
    }
  }
#ifdef G4VERBOSE
  if (verboseLevel > 0)
  {
    G4cout << "G4NeutronFissionXS::IsoXS: Ekin(MeV)= " << ekin / MeV
           << "  xs(b)= " << xs / CLHEP::barn << "  Z= " << Z << "  A= " << A
           << G4endl;
  }
#endif
  return xs;
}

const G4Isotope* G4NeutronFissionXS::SelectIsotope(const G4Element* anElement, G4double kinEnergy,
                                                   G4double logE)
{
  G4int nIso = (G4int)anElement->GetNumberOfIsotopes();
  const G4Isotope* iso = anElement->GetIsotope(0);

  // G4cout << "SelectIsotope NIso= " << nIso << G4endl;
  if (1 == nIso)
  {
    return iso;
  }

  // more than 1 isotope
  G4int Z = anElement->GetZasInt();
  G4int idx = Z - ZMINFIS;

  const G4double* abundVector = anElement->GetRelativeAbundanceVector();
  G4double q = G4UniformRand();
  G4double sum = 0.0;

  // is there isotope wise cross section?
  G4int j;
  if (idx < 0 || idx >= NZFIS || nullptr == data->GetElementData(idx)
      || 0 == data->GetNumberOfComponents(idx))
  {
    for (j = 0; j < nIso; ++j)
    {
      sum += abundVector[j];
      if (q <= sum)
      {
        iso = anElement->GetIsotope(j);
        break;
      }
    }
    return iso;
  }
  G4int nn = (G4int)temp.size();
  if (nn < nIso)
  {
    temp.resize(nIso, 0.);
  }

  for (j = 0; j < nIso; ++j)
  {
    sum += abundVector[j] * IsoCrossSection(kinEnergy, logE, Z, anElement->GetIsotope(j)->GetN());
    temp[j] = sum;
  }
  sum *= q;
  for (j = 0; j < nIso; ++j)
  {
    if (temp[j] >= sum)
    {
      iso = anElement->GetIsotope(j);
      break;
    }
  }
  return iso;
}

void G4NeutronFissionXS::BuildPhysicsTable(const G4ParticleDefinition& p)
{
  CommonInit(temp, p);
}

G4PhysicsVector* G4NeutronFissionXS::GetVector(G4int i)
{
  G4PhysicsVector* v = data->GetElementData(i);
  if (nullptr == v)
  {
    G4AutoLock l(&nFissionXSMutex);
    v = data->GetElementData(i);
    if (nullptr == v)
    {
      Initialise(i + ZMINFIS);
    }
    v = data->GetElementData(i);
    l.unlock();
  }
  return v;
}

void G4NeutronFissionXS::Initialise(G4int Z)
{
  G4int idx = Z - ZMINFIS;
  if (0 > idx || idx >= NZFIS || nullptr != data->GetElementData(idx))
  {
    return;
  }

  // upload element data
  auto v = RetrieveVector(subDir, Z, 0, true);
  data->InitialiseForElement(idx, v);

  // upload element R-data
  auto vr = RetrieveVector(subDirR, Z, 0, false);
  dataR->InitialiseForElement(idx, vr);

  // upload isotope data
  G4bool noComp = true;
  G4bool noCompR = true;
  if (amin[Z] < amax[Z])
  {
    for (G4int A = amin[Z]; A <= amax[Z]; ++A)
    {
      auto v1 = RetrieveVector(subDir, Z, A, false);
      if (nullptr != v1)
      {
        if (noComp)
        {
          G4int nmax = amax[Z] - A + 1;
          data->InitialiseForComponent(idx, nmax);
          noComp = false;
        }
        data->AddComponent(idx, A, v1);
      }
      if (nullptr != vr)
      {
        auto v2 = RetrieveVector(subDirR, Z, A, false);
        if (nullptr != v2)
        {
          if (noCompR)
          {
            G4int nmax = amax[Z] - A + 1;
            dataR->InitialiseForComponent(idx, nmax);
            noCompR = false;
          }
          dataR->AddComponent(idx, A, v2);
        }
      }
    }
  }
  // no components case
  if (noComp)
  {
    data->InitialiseForComponent(idx, 0);
  }
  if (noCompR && nullptr != vr)
  {
    dataR->InitialiseForComponent(idx, 0);
  }
}
