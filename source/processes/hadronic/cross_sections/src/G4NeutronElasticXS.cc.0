#include "G4NeutronElasticXS.hh"

#include "G4AutoLock.hh"
#include "G4ComponentGGHadronNucleusXsc.hh"
#include "G4CrossSectionDataSetRegistry.hh"
#include "G4DynamicParticle.hh"
#include "G4Element.hh"
#include "G4ElementTable.hh"
#include "G4IsotopeList.hh"
#include "G4Material.hh"
#include "G4Neutron.hh"
#include "G4PhysicsLogVector.hh"
#include "G4SystemOfUnits.hh"
#include "Randomize.hh"

G4ElementData* G4NeutronElasticXS::data = nullptr;
G4ElementData* G4NeutronElasticXS::dataR = nullptr;
G4double G4NeutronElasticXS::coeff[] = {1.0};

static std::once_flag applyOnce;

namespace
{
G4Mutex nElasticXSMutex = G4MUTEX_INITIALIZER;
}

G4NeutronElasticXS::G4NeutronElasticXS()
  : G4CrossSectionXS(100*CLHEP::TeV, Default_Name()), neutron(G4Neutron::Neutron())
{
  verboseLevel = 0;
  if (verboseLevel > 0)
  {
    G4cout << "G4NeutronElasticXS Applicable for Z < " << MAXZEL
           << " and energy " << pElimit/CLHEP::eV << " eV - "
           << pEmax/CLHEP::TeV << " TeV  pLogEmax=" << pLogElimit
           << G4endl;
  }
  ggXsection =
    G4CrossSectionDataSetRegistry::Instance()->GetComponentCrossSection("Glauber-Gribov");
  if (ggXsection == nullptr) ggXsection = new G4ComponentGGHadronNucleusXsc();
  if (nullptr == data)
  {
    G4AutoLock l(&nElasticXSMutex);
    if (nullptr == data)
    {
      data = new G4ElementData(MAXZEL);
      data->SetName("nElastic");
      dataR = new G4ElementData(MAXZEL);
      dataR->SetName("nRElastic");
    }
  }
}

void G4NeutronElasticXS::CrossSectionDescription(std::ostream& outFile) const
{
  outFile << "G4NeutronElasticXS calculates the neutron elastic scattering\n"
          << "cross section on nuclei using data from the high precision\n"
          << "neutron database.  These data are simplified and smoothed over\n"
          << "the resonance region in order to reduce CPU time.\n"
          << "For high energies Glauber-Gribiv cross section is used.\n";
}

G4double G4NeutronElasticXS::ElementCrossSection(G4double ekin, G4double loge, G4int ZZ)
{
  G4int Z = std::min(ZZ, MAXZEL - 1);
  G4double xs;

  // data above the resonance region for an element
  auto pv = GetPhysicsVector(Z, data);

  if (ekin < pv->GetMinEnergy())
  {
    // data from the resonance region may exist or not
    auto pvR = dataR->GetElementData(Z);
    if (nullptr != pvR)
    {
      xs = pvR->LogVectorValue(ekin, loge);
    }
    else
    {
      xs = (*pv)[0];
    }
  }
  else if (ekin <= pv->GetMaxEnergy())
  {
    xs = pv->LogVectorValue(ekin, loge);
  }
  else
  {
    xs = coeff[Z] * ggXsection->GetElasticElementCrossSection(neutron, ekin, Z, aeff[Z]);
  }

#ifdef G4VERBOSE
  if (verboseLevel > 1)
  {
    G4cout << "Z= " << Z << " Ekin(MeV)= " << ekin / CLHEP::MeV
           << ",  nElmXSel(b)= " << xs / CLHEP::barn << G4endl;
  }
#endif
  return xs;
}

G4double G4NeutronElasticXS::IsoCrossSection(G4double ekin, G4double loge, G4int ZZ, G4int A)
{
  G4int Z = std::min(ZZ, MAXZEL - 1);
  return ElementCrossSection(ekin, loge, Z) * A / aeff[Z];
}

const G4Isotope* G4NeutronElasticXS::SelectIsotope(const G4Element* anElement, G4double, G4double)
{
  G4int nIso = (G4int)anElement->GetNumberOfIsotopes();
  const G4Isotope* iso = anElement->GetIsotope(0);

  if (1 == nIso)
  {
    return iso;
  }

  const G4double* abundVector = anElement->GetRelativeAbundanceVector();
  G4double q = G4UniformRand();
  G4double sum = 0.0;

  // isotope wise cross section not used
  for (G4int j = 0; j < nIso; ++j)
  {
    sum += abundVector[j];
    if (q <= sum)
    {
      iso = anElement->GetIsotope(j);
      break;
    }
  }
  return iso;
}

void G4NeutronElasticXS::BuildPhysicsTable(const G4ParticleDefinition&)
{
  // initialise static tables only once
  std::call_once(applyOnce, [this]() { isInitializer = true; });

  if (isInitializer)
  {
    G4AutoLock l(&nElasticXSMutex);

    // Access to elements
    const G4ElementTable* table = G4Element::GetElementTable();
    for (auto const& elm : *table)
    {
      G4int Z = std::max(1, std::min(elm->GetZasInt(), MAXZEL - 1));
      if (nullptr == data->GetElementData(Z))
      {
        Initialise(Z);
      }
    }
    l.unlock();
  }
}

void G4NeutronElasticXS::Initialise(G4int Z)
{
  if (nullptr != data->GetElementData(Z))
  {
    return;
  }
  // upload element data
  auto v = RetrieveVector(subDir, Z, 0, true);
  data->InitialiseForElement(Z, v);

  // upload element R-data
  auto vr = RetrieveVector(subDirR, Z, 0, false);
  dataR->InitialiseForElement(Z, vr);

  // smooth transition
  G4double sig1 = (*v)[v->GetVectorLength() - 1];
  G4double ehigh = v->GetMaxEnergy();
  G4double sig2 = ggXsection->GetElasticElementCrossSection(neutron, ehigh, Z, aeff[Z]);
  coeff[Z] = (sig2 > 0.) ? sig1 / sig2 : 1.0;
}
