#ifndef tools_cmemT
#define tools_cmemT

#include <cstdlib>

namespace tools {

template <class T>
inline void cmem_free(T*& a_p){
  if(!a_p) return;
  ::free(a_p);
  a_p = NULL;
}

template <class T>
inline T* cmem_alloc(size_t a_num){
  if(a_num<=0) return 0;
  T* p = (T*)::malloc(a_num*sizeof(T));
  if(!p) return 0;
  return p;
}

template <class T>
inline T* cmem_alloc_copy(const T* a_from,size_t a_num){
  if(a_num<=0) return 0;
  T* p = (T*)::malloc(a_num*sizeof(T));
  if(!p) return 0;
  //::memcpy(p,a_from,a_num*sizeof(T));
  for(size_t i=0;i<a_num;i++) p[i] = a_from[i];
  return p;
}

}

#endif
